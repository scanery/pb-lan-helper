<UserControl x:Class="PBLanHelper.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="34">
  <Grid Background="Transparent" MouseLeftButtonDown="Drag_MouseDown">
    <TextBlock x:Name="TitleText" Margin="14,0,0,0" VerticalAlignment="Center"
               FontSize="12" Foreground="{StaticResource MutedBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource TitleBtn}" Tag="{StaticResource HoverBrush}"
              Content="&#xE921;" Click="Min_Click"/>
      <Button Style="{StaticResource TitleBtn}" Tag="{StaticResource DangerBrush}"
              Content="&#xE8BB;" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</UserControl>