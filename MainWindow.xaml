<Window x:Class="PBLanHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PBLanHelper"
        Title="PB - LAN Helper" Width="800" Height="600"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <local:TitleBar x:Name="TopBar" Panel.ZIndex="10"/>

    <!-- HOME -->
    <Grid x:Name="HomeView" Grid.Row="1">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#0A1020" Offset="0"/>
          <GradientStop Color="#0C1A3A" Offset="0.6"/>
          <GradientStop Color="#3A0E18" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>

      <StackPanel Margin="56,56,0,0" Width="420" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="PB" FontSize="72" FontWeight="Black" FontStyle="Italic" Foreground="White">
            <TextBlock.Effect>
              <DropShadowEffect Color="#1E6BFF" BlurRadius="24" ShadowDepth="0" Opacity="0.9"/>
            </TextBlock.Effect>
          </TextBlock>
          <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="LAN " FontSize="34" FontWeight="Bold"/>
              <TextBlock Text="Helper" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <TextBlock Text="Instalação e manutenção rápida do Point Blank para sua LAN."
                   FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,36"/>

        <Button Style="{StaticResource PrimaryButton}" Height="84" HorizontalContentAlignment="Stretch"
                Click="Install_Click" Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal" Margin="12,0">
            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="30" VerticalAlignment="Center"/>
            <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Instalar" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="Configura o jogo na máquina" FontSize="12" Opacity="0.85"/>
            </StackPanel>
          </StackPanel>
        </Button>

        <Button Style="{StaticResource PanelButton}" Height="84" HorizontalContentAlignment="Stretch"
                Click="Clean_Click">
          <StackPanel Orientation="Horizontal" Margin="12,0">
            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="30" VerticalAlignment="Center"/>
            <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Limpar" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="Remove todos os arquivos do jogo" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </StackPanel>
        </Button>
      </StackPanel>

      <TextBlock x:Name="VersionText" VerticalAlignment="Bottom" Margin="24,0,0,18"
                 FontSize="11" Foreground="{StaticResource MutedBrush}"/>
      <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,24,14" Padding="14,6" Click="OpenSettings_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="Configurações"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- CONFIGURAÇÕES -->
    <Grid x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="12,16">
          <Button Style="{StaticResource PanelButton}" HorizontalContentAlignment="Left" Click="Home_Click" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
              <TextBlock Text="Início"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
              <TextBlock Text="Configurações"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,24">
          <TextBlock Text="Configurações" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>

          <!-- ORIGENS SMB -->
          <TextBlock Text="Origens de rede (SMB)" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="Em ordem de prioridade. Se uma cair durante a cópia, a próxima assume na hora. Desmarque para desativar."
                     FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <ItemsControl x:Name="SmbList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Enabled}" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBox.Style>
                  </TextBox>
                  <Button Grid.Column="2" Style="{StaticResource PanelButton}" Tag="{Binding}" Click="BrowseSmb_Click"
                          Width="42" Margin="8,0,0,0">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"/>
                  </Button>
                  <Button Grid.Column="3" Style="{StaticResource PanelButton}" Tag="{Binding}" Click="Remove_Click"
                          Width="42" Margin="6,0,0,0">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="+ Adicionar origem" Style="{StaticResource GhostButton}" Click="AddSmb_Click"
                  HorizontalAlignment="Left" Padding="14,6" Margin="0,2,0,28"/>

          <!-- ARQUIVOS ZIP -->
          <TextBlock Text="Arquivos .zip para instalar" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="Caminho dentro de cada origem (ex.: LIVE.zip). Cada zip vira uma pasta no destino e um atalho na área de trabalho."
                     FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <ItemsControl x:Name="ZipList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Enabled}" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBox.Style>
                  </TextBox>
                  <Button Grid.Column="2" Style="{StaticResource PanelButton}" Tag="{Binding}" Click="BrowseZip_Click"
                          Width="42" Margin="8,0,0,0">
                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"/>
                  </Button>
                  <Button Grid.Column="3" Style="{StaticResource PanelButton}" Tag="{Binding}" Click="Remove_Click"
                          Width="42" Margin="6,0,0,0">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="+ Adicionar arquivo .zip" Style="{StaticResource GhostButton}" Click="AddZip_Click"
                  HorizontalAlignment="Left" Padding="14,6" Margin="0,2,0,28"/>

          <!-- DESTINO -->
          <TextBlock Text="Arquivos do jogo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Text="Pasta de destino" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          <Grid Margin="0,6,0,28">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtDest"/>
            <Button Grid.Column="1" Style="{StaticResource PanelButton}" Click="BrowseDest_Click"
                    Width="42" Margin="8,0,0,0">
              <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"/>
            </Button>
          </Grid>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12"/>
            <Button Style="{StaticResource GhostButton}" Content="Salvar configurações"
                    Click="Save_Click" Padding="18,9"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>